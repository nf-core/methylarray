/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for iGenomes paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines reference genomes using iGenomes resource allocator.
    Can be used by any config that customises the base path using:
      params.igenomes_base  (default: s3://ngi-igenomes/igenomes/)
----------------------------------------------------------------------------------------
*/

params {
    // iGenomes reference base path
    igenomes_base   = 's3://ngi-igenomes/igenomes/'
    igenomes_ignore = false
}
