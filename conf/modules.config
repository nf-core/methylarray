/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    // Default: publish everything (except versions.yml) under outdir
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'LOG_VERSIONS' {
        publishDir = [
            path: { "${params.outdir}/pipeline_info" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml'))    return null
                if (filename.equals('sessionInfo.txt')) return null
                return filename
            }
        ]
    }

    withName: 'IMPORT_IDAT' {
        ext.args    = { "--annotation '${params.annotation}'" }
        stageInMode = 'symlink'
        publishDir  = [
            path: { "${params.outdir}/import_idat" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml'))                           return null
                if (filename.equals('rg0.rds') && !params.save_intermediates) return null
                return filename
            }
        ]
    }

    withName: 'RAW_INTENSITIES_QC' {
        publishDir = [
            path: { "${params.outdir}/raw_intensities_qc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SESAME_POOBAH_QC' {
        ext.args    = { [
            "--sesame-prep    '${params.sesame_prep}'",
            "--p-det          ${params.p_det}",
            "--fail-sample-fr ${params.fail_sample_fr}",
            "--fail-probe-fr  ${params.fail_probe_fr}"
        ].join(' ').trim() }
        stageInMode = 'symlink'
        publishDir  = [
            path: { "${params.outdir}/sesame_poobah_qc" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml'))                                return null
                if (filename.equals('rg_filtered.rds'))                             return null
                if (filename.equals('beta_norm.rds') && !params.save_intermediates) return null
                return filename
            }
        ]
    }

    withName: 'QC_REPORT_CONTROLS' {
        publishDir = [
            path: { "${params.outdir}/qc_report_controls" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SNP_HEATMAP' {
        publishDir = [
            path: { "${params.outdir}/snp_heatmap" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'DENSITY_PLOTS' {
        publishDir = [
            path: { "${params.outdir}/density_plots" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SEX_QC' {
        publishDir = [
            path: { "${params.outdir}/sex_qc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FILTER_XY_NONCG_BEADS' {
        ext.args   = { [
            "--annotation    '${params.annotation}'",
            "--filter-beads  ${params.filter_beads}",
            "--bead-min       ${params.bead_min}",
            "--bead-fail-frac ${params.bead_fail_frac}",
            "--filter-xy      ${params.filter_xy}",
            "--filter-noncg   ${params.filter_noncg}"
        ].join(' ').trim() }
        publishDir = [
            path: { "${params.outdir}/filter_xy_noncg_beads" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml'))                             return null
                if (filename.equals('beta3.rds') && !params.save_intermediates) return null
                return filename
            }
        ]
    }

    withName: 'CELL_COMP' {
        publishDir = [
            path: { "${params.outdir}/cell_comp" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SPLIT_COLLAPSE' {
        ext.args   = { [
            "--do-rmsnpandch ${params.do_rmsnpandch}",
            "--snp-dist-bp   ${params.snp_dist_bp}",
            "--snp-maf       ${params.snp_maf}"
        ].join(' ').trim() }
        publishDir = [
            path: { "${params.outdir}/split_collapse" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if (filename.equals('versions.yml'))                                    return null
                if (filename.equals('beta_for_DMR_uncollapsed.rds') && !params.run_dmr) return null
                if (filename.equals('beta_clean.rds') && !params.run_dmp)               return null
                return filename
            }
        ]
    }

    withName: 'FINAL_EXPORTS' {
        ext.args   = { [
            "--export-csv ${params.export_csv_matrices}",
            "--save-rds   ${params.save_final_matrices_rds}"
        ].join(' ').trim() }
        publishDir = [
            path: { "${params.outdir}/final_exports" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'ALIGN_META' {
        ext.args   = { [
            params.keep_groups ? "--keep-groups '${params.keep_groups}'" : '',
            "--export-csv ${params.export_csv_matrices}",
            "--include-array ${params.include_array}",
            params.cofactors  ? "--cofactors '${params.cofactors}'"  : ''
        ].join(' ').trim() }
        publishDir = [
            path: { "${params.outdir}/align_meta" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'COVARIATE_PCA' {
        ext.when   = { params.run_covariate_pca }
        ext.args   = { [
            "--run-champ ${params.run_champ_svd}",
            params.cofactors     ? "--cofactors '${params.cofactors}'"          : '',
            params.n_probes_pca  ? "--n-probes-pca ${params.n_probes_pca}"      : '',
            params.n_pcs         ? "--n-pcs ${params.n_pcs}"                    : ''
        ].join(' ').trim() }
        publishDir = [
            path: { "${params.outdir}/covariate_pca" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'DMP_LIMMA' {
        ext.when   = { params.run_dmp }
        ext.args   = { params.cofactors ? "--cofactors '${params.cofactors}'" : '' }
        publishDir = [
            path: { "${params.outdir}/dmp_limma" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'DMR_DMRCATE' {
        ext.when       = { params.run_dmr }
        ext.run_cometh = { params.run_cometh.toString() }
        ext.args       = { [
            "--genome-build     '${params.genome_build}'",
            params.keep_groups ? "--keep-groups '${params.keep_groups}'" : '',
            "--posreps-strategy '${params.posreps_strategy}'",
            "--epicv2-remap     ${params.epicv2_remap}",
            params.cofactors   ? "--cofactors '${params.cofactors}'"   : ''
        ].join(' ').trim() }
        publishDir = [
            path: { "${params.outdir}/dmr_dmrcate" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}
