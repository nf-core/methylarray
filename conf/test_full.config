/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a full size pipeline test.

    Use as follows:
        nextflow run nf-core/methylarray -profile test_full,docker --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'Full test dataset to check pipeline function'

    // Input data
    input    = params.pipelines_testdata_base_path + 'methylarray/samplesheet/samplesheet_full.tsv'
    idat_dir = params.pipelines_testdata_base_path + 'methylarray/idat/'
    meta_file = params.pipelines_testdata_base_path + 'methylarray/metadata/meta_full.csv'

    // Groups for EWAS filtering (required for validation)
    keep_groups = 'CONTROL,CCA,PSC,GBC'
}
