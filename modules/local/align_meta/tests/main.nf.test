nextflow_process {

    name "Test ALIGN_META"
    script "../main.nf"
    process "ALIGN_META"
    tag "modules"
    tag "modules_local"
    tag "align_meta"

    test("stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = file("stub_bvals.rds")
                input[1] = file("stub_mvals.rds")
                input[2] = file("stub_targets.tsv")
                input[3] = file("stub_meta.csv")
                input[4] = []
                input[5] = file("stub_pred_sex.csv")
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
