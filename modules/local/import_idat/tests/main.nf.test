nextflow_process {

    name "Test IMPORT_IDAT"
    script "../main.nf"
    process "IMPORT_IDAT"
    tag "modules"
    tag "modules_local"
    tag "import_idat"

    test("stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = file("stub_samplesheet.tsv")
                input[1] = file("stub_idat_dir")
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
