nextflow_process {

    name "Test SPLIT_COLLAPSE"
    script "../main.nf"
    process "SPLIT_COLLAPSE"
    tag "modules"
    tag "modules_local"
    tag "split_collapse"

    test("stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = file("stub_beta3.rds")
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
