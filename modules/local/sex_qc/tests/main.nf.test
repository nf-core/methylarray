nextflow_process {

    name "Test SEX_QC"
    script "../main.nf"
    process "SEX_QC"
    tag "modules"
    tag "modules_local"
    tag "sex_qc"

    test("stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = file("stub_rg_filtered.rds")
                input[1] = file("stub_targets.tsv")
                input[2] = file("stub_meta.csv")
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
