nextflow_process {

    name "Test SNP_HEATMAP"
    script "../main.nf"
    process "SNP_HEATMAP"
    tag "modules"
    tag "modules_local"
    tag "snp_heatmap"

    test("stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = file("stub_rg.rds")
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
