nextflow_process {

    name "Test DMP_LIMMA"
    script "../main.nf"
    process "DMP_LIMMA"
    tag "modules"
    tag "modules_local"
    tag "dmp_limma"

    test("stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = file("stub_mvals_aligned.rds")
                input[1] = file("stub_bvals_aligned.rds")
                input[2] = file("stub_meta_aligned.csv")
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
